{
  "buildCommand": "node tools/build.js --dist",
  "outputDirectory": "dist",
  "installCommand": "",
  "headers": [
    { "source": "/engine.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/m/(.*).js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/thumbs/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
